{
  "name": "image-camera-tour",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "expo": "^58.0.0",
    "expo-camera": "~58.0.14",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-media-library": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-web": "^0.21.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:infrastructure": "jest --runInBand __tests__/infrastructure",
    "check-progress": "node scripts/check-progress.js",
    "check-progress:report": "node scripts/check-progress.js --report-only",
    "verify": "npm run check-progress && npm run lint && npm run typecheck && npm test"
  },
  "private": true,
  "devDependencies": {
    "@babel/parser": "^8.0.10",
    "@babel/traverse": "^8.0.10",
    "@testing-library/react-native": "^14.1.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "typescript": "~6.0.3"
  }
}
